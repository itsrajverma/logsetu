# ---- LogSetu server (docker compose) ----

# Required: password for the dashboard login
LOGSETU_ADMIN_PASSWORD=change-me

# Recommended: random string used to sign session cookies (defaults to a derivation of the password)
#   generate one:  openssl rand -hex 32
LOGSETU_SECRET=

# Port on the host for the dashboard + API (container always listens on 8686)
LOGSETU_PORT=8686

# Storage. SQLite (default, zero config) or Postgres (docker-compose.prod.yml).
# DATABASE_URL=file:/data/logsetu.db
# DATABASE_URL=postgresql://logsetu:password@db:5432/logsetu

# Postgres credentials (docker-compose.prod.yml only)
POSTGRES_USER=logsetu
POSTGRES_PASSWORD=
POSTGRES_DB=logsetu

# Optional tuning
LOGSETU_RATE_LIMIT_PER_MIN=1000
# Delete logs older than N days (projects can override in the dashboard). Unset = keep forever.
# LOGSETU_DEFAULT_RETENTION_DAYS=30
# LOGSETU_SECURE_COOKIES=1   # when served over HTTPS

# Alerts: dashboard URL used in notification links, and SMTP for email alerts
# LOGSETU_PUBLIC_URL=https://logs.example.com
# LOGSETU_SMTP_URL=smtps://user:pass@smtp.example.com:465
# LOGSETU_SMTP_FROM=LogSetu <alerts@example.com>

# OpenTelemetry: forward every log to an OTLP/HTTP collector (docs/opentelemetry.md)
# LOGSETU_OTLP_ENDPOINT=http://otel-collector:4318
# LOGSETU_OTLP_HEADERS=Authorization=Bearer%20token
# LOGSETU_OTLP_PROJECTS=acme-storefront
