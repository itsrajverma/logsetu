# Admin password for the dashboard (required)
LOGSETU_ADMIN_PASSWORD=change-me

# SQLite by default. Switch to Postgres by setting a postgres:// URL.
DATABASE_URL=file:./data/logsetu.db
# DATABASE_URL=postgresql://logsetu:logsetu@localhost:5432/logsetu

# Optional
# LOGSETU_RATE_LIMIT_PER_MIN=1000
# LOGSETU_DEFAULT_RETENTION_DAYS=30
# LOGSETU_SECRET=random-string-to-sign-session-cookies
