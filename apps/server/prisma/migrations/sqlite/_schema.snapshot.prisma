generator client {
  provider = "prisma-client"
  output   = "../../generated/sqlite"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id        String     @id @default(cuid())
  name      String
  apiKey        String     @unique
  retentionDays Int?       // null = use LOGSETU_DEFAULT_RETENTION_DAYS (or keep forever)
  createdAt     DateTime   @default(now())
  logs          LogEntry[]
  issues        Issue[]
  alertRules    AlertRule[]
}

model LogEntry {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  level       String
  message     String
  source      String   @default("unknown")
  environment String   @default("production")
  meta        Json?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  issueId     String?
  issue       Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([projectId, timestamp(sort: Desc)])
  @@index([projectId, level, timestamp(sort: Desc)])
  @@index([projectId, source])
  @@index([projectId, environment])
  @@index([issueId, timestamp(sort: Desc)])
}

// Error grouping: error/fatal logs with the same fingerprint collapse into one issue.
model Issue {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fingerprint String
  title       String
  culprit     String?
  level       String
  source      String
  status      String     @default("open") // open | resolved | ignored
  count       Int        @default(0)
  firstSeen   DateTime
  lastSeen    DateTime
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())
  logs        LogEntry[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status, lastSeen(sort: Desc)])
  @@index([projectId, lastSeen(sort: Desc)])
}


// Alerting: notify a webhook / Slack / email when a threshold is crossed or a new issue appears.
model AlertRule {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean      @default(true)
  trigger         String       @default("threshold") // threshold | new_issue
  levels          String       @default("error,fatal") // comma-separated
  source          String?
  environment     String?
  threshold       Int          @default(10)
  windowMinutes   Int          @default(5)
  cooldownMinutes Int          @default(15)
  channel         String // webhook | slack | email
  target          String // URL, or comma-separated email addresses
  lastTriggeredAt DateTime?
  createdAt       DateTime     @default(now())
  events          AlertEvent[]

  @@index([projectId])
}

model AlertEvent {
  id        String    @id @default(cuid())
  ruleId    String
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  projectId String
  message   String
  count     Int       @default(0)
  success   Boolean
  error     String?
  test      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([ruleId, createdAt(sort: Desc)])
}
