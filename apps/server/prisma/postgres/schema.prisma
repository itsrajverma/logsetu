generator client {
  provider = "prisma-client"
  output   = "../../generated/postgres"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String     @id @default(cuid())
  name      String
  apiKey        String     @unique
  retentionDays Int?       // null = use LOGSETU_DEFAULT_RETENTION_DAYS (or keep forever)
  createdAt     DateTime   @default(now())
  logs          LogEntry[]
}

model LogEntry {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  level       String
  message     String
  source      String   @default("unknown")
  environment String   @default("production")
  meta        Json?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([projectId, timestamp(sort: Desc)])
  @@index([projectId, level, timestamp(sort: Desc)])
  @@index([projectId, source])
  @@index([projectId, environment])
}

